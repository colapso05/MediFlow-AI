# ---------------------------------------------------------------------------
# Copia este archivo como .env y completa los valores marcados.
# El archivo .env NUNCA se sube al repositorio.
# ---------------------------------------------------------------------------

# Modelo que conversa con el paciente.
# La clave se obtiene en https://platform.deepseek.com  ->  API keys
DEEPSEEK_API_KEY=coloca_tu_api_key_aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Base de datos PostgreSQL (la levanta docker compose).
POSTGRES_USER=mediflow
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
POSTGRES_DB=mediflow_db

# Cadena de conexión que usa la API.
# Debe llevar la misma contraseña que POSTGRES_PASSWORD.
# El puerto 5433 es el que publica docker-compose.yml en este equipo.
DATABASE_URL=postgresql://mediflow:CAMBIA_ESTA_CONTRASENA@127.0.0.1:5433/mediflow_db

# Agrupación de mensajes seguidos (segundos).
# Si un paciente escribe "hola", "necesito hora" y "con el doctor rojas" con
# menos de este tiempo entre mensaje y mensaje, el agente responde una sola vez
# con los tres juntos. Subirlo agrupa más; bajarlo responde más rápido.
# Se lee en backend/main.py, línea 213. Si se borra, el valor por defecto es 2.5.
VENTANA_AGRUPACION=2.5
